<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrato del servicio (contract-first).
     De aqui se generan: el WSDL y las clases Java del paquete ...ws -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://ejemplo.com/productos/ws"
           targetNamespace="http://ejemplo.com/productos/ws"
           elementFormDefault="qualified">

    <!-- ===== Tipos ===== -->
    <xs:complexType name="categoriaDto">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="nombre" type="xs:string"/>
            <xs:element name="descripcion" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="productoDto">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="nombre" type="xs:string"/>
            <xs:element name="precio" type="xs:decimal"/>
            <xs:element name="stock" type="xs:int"/>
            <xs:element name="categoria" type="tns:categoriaDto"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ===== Operacion: listarProductos (filtro opcional por categoria) ===== -->
    <xs:element name="listarProductosRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="categoriaId" type="xs:int" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="listarProductosResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="producto" type="tns:productoDto" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ===== Operacion: obtenerProducto ===== -->
    <xs:element name="obtenerProductoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="obtenerProductoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="producto" type="tns:productoDto"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ===== Operacion: listarCategorias ===== -->
    <xs:element name="listarCategoriasRequest">
        <xs:complexType/>
    </xs:element>
    <xs:element name="listarCategoriasResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="categoria" type="tns:categoriaDto" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ===== Operacion: registrarProducto ===== -->
    <xs:element name="registrarProductoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="nombre" type="xs:string"/>
                <xs:element name="precio" type="xs:decimal"/>
                <xs:element name="stock" type="xs:int"/>
                <xs:element name="categoriaId" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="registrarProductoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="producto" type="tns:productoDto"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
